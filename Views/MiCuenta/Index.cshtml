@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2 class="text-success">
            👤 Mi perfil
        </h2>

        <p class="text-secondary">
            Información y seguridad de tu cuenta ByteStore.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card bg-dark text-light border-secondary h-100">

                <div class="card-body p-4">

                    <div class="fs-2 mb-3">
                        📧
                    </div>

                    <h5 class="card-title text-success">
                        Correo electrónico
                    </h5>

                    <p class="card-text text-secondary">
                        Consultá o actualizá el correo electrónico
                        asociado a tu cuenta.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-dark text-light border-secondary h-100">

                <div class="card-body p-4">

                    <div class="fs-2 mb-3">
                        🔒
                    </div>

                    <h5 class="card-title text-success">
                        Cambiar contraseña
                    </h5>

                    <p class="card-text text-secondary">
                        Modificá tu contraseña para mantener
                        protegida tu cuenta.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-dark text-light border-secondary h-100">

                <div class="card-body p-4">

                    <div class="fs-2 mb-3">
                        🛡️
                    </div>

                    <h5 class="card-title text-success">
                        Seguridad de la cuenta
                    </h5>

                    <p class="card-text text-secondary">
                        Consultá las opciones de seguridad
                        disponibles para tu cuenta.
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-success">
            Volver al inicio
        </a>

    </div>

</div>

