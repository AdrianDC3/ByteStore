@model List<ByteStore.Models.Producto>

@{
    ViewData["Title"] = "Administrar productos";
}

<div class="container mt-4 mb-5">

    <!-- TITULO Y NUEVO PRODUCTO -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <h2 class="text-success mb-0">
            📦 Administración de productos
        </h2>

        <a asp-controller="AdminProductos"
           asp-action="Crear"
           class="btn btn-success">
            + Nuevo producto
        </a>

    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- BUSCADOR Y FILTROS -->
    <partial name="_FiltrosAdmin" />

    <!-- CANTIDAD DE PRODUCTOS -->
    <p class="text-secondary mb-4">
        Productos encontrados: @Model.Count
    </p>

    <!-- TABLA DE PRODUCTOS -->
    <partial name="_TablaProductos" model="Model" />

</div>