@model List<ByteStore.Models.Producto>

@{
    ViewData["Title"] = "Administrar productos";
}

<div class="container mt-4">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <h2 class="text-success mb-0">
            📦 Administración de productos
        </h2>

        <a asp-controller="AdminProductos"
           asp-action="Crear"
           class="btn btn-success">

            + Nuevo producto

        </a>

    </div>

    <!-- MENSAJES -->

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- FILTROS -->

    <partial name="_FiltrosAdmin" />

    <!-- RESULTADOS -->

    <p class="text-secondary">
        Productos encontrados: @Model.Count
    </p>

    <!-- TABLA -->

    <partial name="_TablaProductos" model="Model" />

    <!-- VOLVER -->

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">

        Volver al catálogo

    </a>

</div>

@section Scripts {

    <script src="~/js/admin-productos.js"
            asp-append-version="true"></script>

}