@model List<ByteStore.Models.ItemCarrito>

@{
    ViewData["Title"] = "Finalizar compra";

    decimal total = Model.Sum(item => item.Subtotal);

    bool carritoValido = Model.Any() && ViewBag.Error == null;
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2 class="text-success">
            💳 Finalizar compra
        </h2>

        <p class="text-secondary">
            Revisá los productos seleccionados y completá los datos de pago.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (!carritoValido)
    {
        <div class="card bg-dark text-light border-secondary">
            <div class="card-body text-center py-5">

                <h4>
                    Tu carrito está vacío o necesita actualizarse
                </h4>

                <p class="text-secondary">
                    Agregá productos al carrito para iniciar una nueva compra.
                    Las compras anteriores están disponibles en Mis pedidos.
                </p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-success">
                    Explorar productos
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- RESULTADO DE LA COMPRA -->
        <div id="resultadoCompra"
             class="card bg-dark text-light border-success d-none mb-4">

            <div class="card-body text-center py-5">

                <div class="display-4 text-success mb-3">
                    ✓
                </div>

                <h3 class="text-success mb-3">
                    ¡Compra confirmada!
                </h3>

                <p class="text-light">
                    El pago de prueba fue aprobado
                    y tu pedido se registró correctamente.
                </p>

                <h5 id="numeroPedidoConfirmado"
                    class="text-success mb-4">
                </h5>

                <a asp-controller="Pedidos"
                   asp-action="MisPedidos"
                   class="btn btn-success">
                    Ver mis pedidos
                </a>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Seguir comprando
                </a>

            </div>
        </div>

        <div id="contenidoCheckout" class="row g-4">

            <!-- RESUMEN DEL PEDIDO -->
            <div class="col-lg-5">

                <div class="card bg-dark text-light border-secondary h-100">

                    <div class="card-header border-secondary p-3">
                        <h5 class="text-success mb-0">
                            🛒 Resumen del pedido
                        </h5>
                    </div>

                    <div class="card-body">

                        @foreach (var item in Model)
                        {
                            <div class="d-flex justify-content-between gap-3 mb-3">

                                <div>
                                    <h6 class="mb-1">
                                        @item.Nombre
                                    </h6>

                                    <small class="text-secondary">
                                        Cantidad: @item.Cantidad
                                    </small>

                                    <div class="text-secondary small">
                                        Precio unitario:
                                        $ @item.Precio.ToString("N2")
                                    </div>
                                </div>

                                <div class="text-end text-nowrap">
                                    $ @item.Subtotal.ToString("N2")
                                </div>

                            </div>

                            <hr class="border-secondary" />
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <h5 class="mb-0">
                                Total
                            </h5>

                            <h4 class="text-success mb-0">
                                $ @total.ToString("N2")
                            </h4>

                        </div>

                    </div>

                    <div class="card-footer border-secondary p-3">

                        <a asp-controller="Productos"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100">
                            Seguir comprando
                        </a>

                    </div>

                </div>

            </div>

            <!-- FORMULARIO DE PAGO -->
            <div class="col-lg-7">

                <div class="card bg-dark text-light border-secondary">

                    <div class="card-header border-secondary p-3">

                        <h5 class="text-success mb-0">
                            💳 Datos de la tarjeta
                        </h5>

                    </div>

                    <div class="card-body p-4">

                        <form id="formPagoSimulado"
                              asp-controller="Pedidos"
                              asp-action="Confirmar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div id="mensajePago"
                                 class="alert alert-danger d-none"
                                 role="alert"
                                 aria-live="polite">
                            </div>

                            <!-- TIPO DE TARJETA -->
                            <div class="mb-3">

                                <label for="tipoTarjeta"
                                       class="form-label">
                                    Tipo de tarjeta
                                </label>

                                <select id="tipoTarjeta"
                                        name="TipoTarjeta"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Seleccioná una opción
                                    </option>

                                    <option value="Credito">
                                        Crédito
                                    </option>

                                    <option value="Debito">
                                        Débito
                                    </option>

                                </select>

                            </div>

                            <!-- TITULAR -->
                            <div class="mb-3">

                                <label for="titularTarjeta"
                                       class="form-label">
                                    Nombre del titular
                                </label>

                                <input type="text"
                                       id="titularTarjeta"
                                       name="Titular"
                                       class="form-control"
                                       placeholder="JUAN PEREZ"
                                       minlength="3"
                                       maxlength="100"
                                       autocomplete="off"
                                       required />

                            </div>

                            <!-- NUMERO DE TARJETA -->
                            <div class="mb-3">

                                <label for="numeroTarjeta"
                                       class="form-label">
                                    Número de tarjeta
                                </label>

                                <input type="text"
                                       id="numeroTarjeta"
                                       name="NumeroTarjeta"
                                       class="form-control"
                                       placeholder="1234 5678 9012 3456"
                                       inputmode="numeric"
                                       maxlength="19"
                                       autocomplete="off"
                                       pattern="[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}"
                                       title="Ingresá 16 números en grupos de cuatro."
                                       required />

                                <div class="form-text text-secondary">
                                    Utilizá únicamente números ficticios.
                                </div>

                            </div>

                            <div class="row g-3">

                                <!-- VENCIMIENTO -->
                                <div class="col-md-6">

                                    <label for="vencimientoTarjeta"
                                           class="form-label">
                                        Vencimiento
                                    </label>

                                    <input type="text"
                                           id="vencimientoTarjeta"
                                           name="Vencimiento"
                                           class="form-control"
                                           placeholder="MM/AA"
                                           maxlength="5"
                                           autocomplete="off"
                                           pattern="(0[1-9]|1[0-2])/[0-9]{2}"
                                           title="Ingresá una fecha en formato MM/AA."
                                           required />

                                </div>

                                <!-- CODIGO DE SEGURIDAD -->
                                <div class="col-md-6">

                                    <label for="codigoSeguridad"
                                           class="form-label">
                                        Código de seguridad
                                    </label>

                                    <input type="text"
                                           id="codigoSeguridad"
                                           name="CodigoSeguridad"
                                           class="form-control"
                                           placeholder="123"
                                           inputmode="numeric"
                                           maxlength="3"
                                           autocomplete="off"
                                           pattern="[0-9]{3}"
                                           title="Ingresá tres dígitos ficticios."
                                           required />

                                </div>

                            </div>

                            <hr class="border-secondary my-4" />

                            <p class="text-secondary small">
                                🔒 Pago de prueba. No ingreses datos
                                de tarjetas reales.
                            </p>

                            <!-- CONFIRMAR COMPRA -->
                            <button type="submit"
                                    id="botonConfirmarPago"
                                    class="btn btn-success w-100 fw-semibold">
                                Confirmar pago
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const numero = document.getElementById("numeroTarjeta");
            const vencimiento = document.getElementById("vencimientoTarjeta");

            // FORMATEAR NUMERO DE TARJETA
            if (numero instanceof HTMLInputElement) {

                numero.addEventListener("input", function () {

                    const digitos = numero.value
                        .replace(/\D/g, "")
                        .slice(0, 16);

                    numero.value = digitos
                        .replace(/(\d{4})(?=\d)/g, "$1 ");

                });

            }

            // FORMATEAR VENCIMIENTO
            if (vencimiento instanceof HTMLInputElement) {

                vencimiento.addEventListener("input", function () {

                    const digitos = vencimiento.value
                        .replace(/\D/g, "")
                        .slice(0, 4);

                    vencimiento.value = digitos.length > 2
                        ? digitos.slice(0, 2) + "/" + digitos.slice(2)
                        : digitos;

                });

            }

            // CONFIRMAR PAGO Y REGISTRAR PEDIDO
            const formularioPago =
                document.getElementById("formPagoSimulado");

            if (formularioPago instanceof HTMLFormElement) {

                formularioPago.addEventListener("submit", async function (evento) {

                    evento.preventDefault();

                    const formulario = evento.currentTarget;

                    const boton =
                        document.getElementById("botonConfirmarPago");

                    const mensaje =
                        document.getElementById("mensajePago");

                    const contenido =
                        document.getElementById("contenidoCheckout");

                    const resultadoCompra =
                        document.getElementById("resultadoCompra");

                    const numeroPedido =
                        document.getElementById("numeroPedidoConfirmado");

                    if (!(formulario instanceof HTMLFormElement) ||
                        !(boton instanceof HTMLButtonElement) ||
                        !(mensaje instanceof HTMLElement) ||
                        !(contenido instanceof HTMLElement) ||
                        !(resultadoCompra instanceof HTMLElement) ||
                        !(numeroPedido instanceof HTMLElement)) {
                        return;
                    }

                    if (!formulario.reportValidity()) {
                        return;
                    }

                    mensaje.textContent = "";
                    mensaje.classList.add("d-none");

                    boton.disabled = true;
                    boton.textContent = "Procesando compra...";

                    let compraConfirmada = false;

                    try {

                        const respuesta = await fetch(formulario.action, {
                            method: "POST",
                            body: new FormData(formulario),
                            credentials: "same-origin",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        });

                        if (respuesta.redirected) {
                            window.location.href = respuesta.url;
                            return;
                        }

                        const datos = await respuesta.json();

                        if (!respuesta.ok || datos.exito !== true) {

                            mensaje.textContent =
                                typeof datos.error === "string"
                                    ? datos.error
                                    : "No se pudo confirmar la compra.";

                            mensaje.classList.remove("d-none");
                            return;
                        }

                        compraConfirmada = true;

                        // NO CONSERVAR LOS DATOS FICTICIOS
                        formulario.reset();

                        // OCULTAR FORMULARIO Y MOSTRAR CONFIRMACION
                        contenido.classList.add("d-none");

                        numeroPedido.textContent =
                            "Número de pedido: #" + datos.pedidoId;

                        resultadoCompra.classList.remove("d-none");

                        // ACTUALIZAR CONTADOR DEL CARRITO
                        const contador =
                            document.getElementById("contadorCarrito");

                        if (contador instanceof HTMLElement) {
                            contador.textContent = "0";
                            contador.classList.add("d-none");
                        }

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });

                    }
                    catch (error) {

                        mensaje.textContent =
                            "Ocurrió un problema al procesar la compra. " +
                            "Revisá Mis pedidos antes de volver a intentar.";

                        mensaje.classList.remove("d-none");

                    }
                    finally {

                        if (!compraConfirmada) {
                            boton.disabled = false;
                            boton.textContent = "Confirmar pago";
                        }

                    }

                });

            }

        });
    </script>
}
