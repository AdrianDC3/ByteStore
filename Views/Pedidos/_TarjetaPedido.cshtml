@model ByteStore.Models.Pedido

<div class="card bg-dark text-light border-secondary mb-4">

    <!-- ENCABEZADO -->

    <div class="card-header d-flex justify-content-between flex-wrap gap-2">

        <strong>
            Pedido #@Model.Id
        </strong>

        <span class="text-secondary">
            @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </span>

        <span class="badge bg-warning text-dark">
            @Model.Estado
        </span>

    </div>

    <!-- DETALLE -->

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-dark table-striped">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>

                            <td>
                                @detalle.Producto.Nombre
                            </td>

                            <td>
                                @detalle.Cantidad
                            </td>

                            <td>
                                $ @detalle.PrecioUnitario.ToString("N2")
                            </td>

                            <td>
                                $ @((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- TOTAL -->

        <h4 class="text-success text-end mt-3">
            Total: $ @Model.Total.ToString("N2")
        </h4>

    </div>

</div>