@model List<ByteStore.Models.Pedido>

@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="container mt-4">

    <h2 class="text-success mb-4">Mis pedidos</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            Todavía no realizaste ninguna compra.
        </div>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-success">
            Explorar productos
        </a>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            <div class="card bg-dark text-light border-secondary mb-4">

                <div class="card-header d-flex justify-content-between flex-wrap gap-2">

                    <strong>Pedido #@pedido.Id</strong>

                    <span class="text-secondary">
                        @pedido.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </span>

                    <span class="badge bg-warning text-dark">
                        @pedido.Estado
                    </span>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-dark table-striped">

                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio unitario</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var detalle in pedido.Detalles)
                                {
                                    <tr>
                                        <td>@detalle.Producto.Nombre</td>
                                        <td>@detalle.Cantidad</td>
                                        <td>$ @detalle.PrecioUnitario.ToString("N2")</td>
                                        <td>
                                            $ @((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

                    <h4 class="text-success text-end mt-3">
                        Total: $ @pedido.Total.ToString("N2")
                    </h4>

                </div>

            </div>
        }
    }

</div>
