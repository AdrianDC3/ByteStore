@model IEnumerable<ByteStore.Models.Producto>

@{
    ViewData["Title"] = "Catálogo";
}

<style>
    /* TARJETAS DE PRODUCTOS */

    .producto-card {
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .producto-card:hover {
            transform: translateY(-4px);
            border-color: #198754 !important;
        }

    /* CONTENEDOR DE IMAGEN */

    .producto-imagen-contenedor {
        height: 230px;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        overflow: hidden;
    }

    /* IMAGEN DEL PRODUCTO */

    .producto-imagen {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.25s ease;
    }

    .producto-card:hover .producto-imagen {
        transform: scale(1.05);
    }

    /* INFORMACION */

    .producto-nombre {
        min-height: 48px;
        font-weight: 600;
    }

    .producto-descripcion {
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .producto-precio {
        font-size: 1.35rem;
        font-weight: 700;
    }

    .producto-stock {
        font-size: 0.9rem;
    }

    /* ADAPTACION A CELULARES */

    @@media (max-width: 767px) {
        .producto-imagen-contenedor {
            height: 210px;
        }
    }
</style>

<div class="container pb-5">

    <!-- TITULO DEL CATALOGO -->

    <h1 class="mb-4 fw-bold">
        Catálogo de productos
    </h1>

    <!-- BUSCADOR Y FILTROS -->

    <form asp-controller="Productos"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <!-- BUSCADOR -->

        <div class="col-md-4">

            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar productos..." />

        </div>

        <!-- FILTRO DE CATEGORIA -->

        <div class="col-md-3">

            <select name="categoriaId"
                    asp-items="ViewBag.Categorias"
                    class="form-select">

                <option value="">
                    Todas las categorías
                </option>

            </select>

        </div>

        <!-- FILTRO DE MARCA -->

        <div class="col-md-3">

            <select name="marcaId"
                    asp-items="ViewBag.Marcas"
                    class="form-select">

                <option value="">
                    Todas las marcas
                </option>

            </select>

        </div>

        <!-- BOTON BUSCAR -->

        <div class="col-md-2 d-grid">

            <button type="submit"
                    class="btn btn-success">
                Buscar
            </button>

        </div>

        <!-- LIMPIAR FILTROS -->

        <div class="col-12">

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-outline-light btn-sm">
                Limpiar filtros
            </a>

        </div>

    </form>

    <!-- CANTIDAD DE RESULTADOS -->

    <p class="text-secondary mb-4">
        Productos encontrados: @Model.Count()
    </p>

    <!-- LISTADO DE PRODUCTOS -->
    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            No se encontraron productos.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var producto in Model)
            {
                // Las imágenes están guardadas en formato JFIF.
                // Cada archivo utiliza el ID del producto.
                var rutaImagen = Url.Content(
                    $"~/images/productos/producto-{producto.Id}.jfif"
                );

                <div class="col-md-6 col-lg-4">

                    <div class="card bg-dark text-light h-100 border-secondary producto-card">

                        <!-- FOTOGRAFIA DEL PRODUCTO -->

                        <a asp-controller="Productos"
                           asp-action="Detalle"
                           asp-route-id="@producto.Id"
                           class="text-decoration-none">

                            <div class="producto-imagen-contenedor">

                                <img src="@rutaImagen"
                                     class="producto-imagen"
                                     alt="@producto.Nombre"
                                     loading="lazy" />

                            </div>

                        </a>

                        <!-- INFORMACION DEL PRODUCTO -->

                        <div class="card-body d-flex flex-column">

                            <!-- NOMBRE -->

                            <h5 class="card-title producto-nombre">
                                @producto.Nombre
                            </h5>

                            <!-- CATEGORIA Y MARCA -->

                            <p class="text-secondary small mb-2">

                                @producto.Categoria?.Nombre

                                |

                                @producto.Marca?.Nombre

                            </p>

                            <!-- DESCRIPCION -->

                            <p class="card-text text-secondary producto-descripcion">
                                @producto.Descripcion
                            </p>

                            <!-- PRECIO -->

                            <p class="text-success producto-precio mt-auto mb-2">

                                $ @producto.Precio.ToString("N2")

                            </p>

                            <!-- STOCK -->
                            @if (producto.Stock > 0)
                            {
                                <p class="text-light producto-stock mb-0">

                                    <span class="text-success">●</span>

                                    Stock disponible: @producto.Stock

                                </p>
                            }
                            else
                            {
                                <p class="text-danger producto-stock mb-0">

                                    ● Sin stock

                                </p>
                            }

                            <!-- VER DETALLE -->

                            <a asp-controller="Productos"
                               asp-action="Detalle"
                               asp-route-id="@producto.Id"
                               class="btn btn-outline-success mt-3">

                                Ver detalle

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>