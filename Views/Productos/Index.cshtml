
@model IEnumerable<ByteStore.Models.Producto>

@{
    ViewData["Title"] = "Catálogo";

    // =====================================================
    // RELACION ENTRE PRODUCTOS Y FOTOGRAFIAS
    // =====================================================
    //
    // Las fotografias conservan los IDs originales
    // de nuestra base de datos LocalDB.
    //
    // Como en SQL Server remoto los productos tienen
    // IDs diferentes, identificamos cada fotografia
    // utilizando el nombre del producto.
    //
    // Asi ambas bases utilizan las mismas 44 imagenes.

    var imagenesProductos = new Dictionary<string, int>(
        StringComparer.OrdinalIgnoreCase)
    {
        // PROCESADORES
        { "Procesador AMD Ryzen 7 5700X", 1 },
        { "AMD Ryzen 5 5600", 2 },
        { "Intel Core i5 12400F", 3 },
        { "Intel Core i7 12700K", 4 },

        // MOTHERBOARDS
        { "ASUS Prime B550M-A", 5 },
        { "MSI B550 Gaming Plus", 6 },
        { "Gigabyte B760M DS3H", 7 },
        { "ASUS TUF Gaming B650", 8 },

        // TARJETAS GRAFICAS
        { "MSI GeForce RTX 4060", 9 },
        { "ASUS GeForce RTX 4070", 10 },
        { "Gigabyte Radeon RX 7600", 11 },
        { "MSI Radeon RX 6600", 12 },

        // MEMORIAS RAM
        { "Kingston Fury Beast 16GB DDR4", 13 },
        { "Corsair Vengeance 16GB DDR4", 14 },
        { "Kingston Fury Beast 32GB DDR5", 15 },
        { "Corsair Vengeance 32GB DDR5", 16 },

        // ALMACENAMIENTO
        { "Kingston NV2 500GB", 17 },
        { "Kingston NV2 1TB", 18 },
        { "Samsung 990 PRO 1TB", 19 },
        { "WD Blue SN580 1TB", 20 },

        // FUENTES DE ALIMENTACION
        { "Corsair CX550", 21 },
        { "Cooler Master MWE 650", 22 },
        { "Seasonic Focus GX 750", 23 },
        { "Corsair RM850e", 24 },

        // REFRIGERACION
        { "DeepCool AK400", 25 },
        { "Cooler Master Hyper 212", 26 },
        { "DeepCool AK620", 27 },
        { "NZXT Kraken 240", 28 },

        // GABINETES
        { "Corsair 4000D Airflow", 29 },
        { "NZXT H5 Flow", 30 },
        { "Cooler Master TD500 Mesh", 31 },
        { "DeepCool CH370", 32 },

        // MOUSE
        { "Logitech G203", 33 },
        { "Logitech G305", 34 },
        { "Razer DeathAdder V2", 35 },
        { "Redragon Cobra M711", 36 },

        // TECLADOS
        { "Redragon Kumara K552", 37 },
        { "Logitech G213", 38 },
        { "Razer BlackWidow V3", 39 },
        { "Corsair K70 RGB", 40 },

        // MONITORES
        { "LG UltraGear 24GN60R", 41 },
        { "Samsung Odyssey G4 25", 42 },
        { "ASUS TUF VG27AQ", 43 },
        { "Acer Nitro VG240Y", 44 }
    };
}

<style>
    /* =====================================================
       TARJETAS DE PRODUCTOS
       ===================================================== */

    .producto-card {
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .producto-card:hover {
        transform: translateY(-4px);
        border-color: #198754 !important;
    }

    /* =====================================================
       CONTENEDOR DE IMAGEN
       ===================================================== */

    .producto-imagen-contenedor {
        height: 230px;
        background-color: #ffffff;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 18px;
        overflow: hidden;
    }

    /* =====================================================
       IMAGEN DEL PRODUCTO
       ===================================================== */

    .producto-imagen {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.25s ease;
    }

    .producto-card:hover .producto-imagen {
        transform: scale(1.05);
    }

    /* =====================================================
       INFORMACION DEL PRODUCTO
       ===================================================== */

    .producto-nombre {
        min-height: 48px;
        font-weight: 600;
    }

    .producto-descripcion {
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .producto-precio {
        font-size: 1.35rem;
        font-weight: 700;
    }

    .producto-stock {
        font-size: 0.9rem;
    }

    /* =====================================================
       ADAPTACION A CELULARES
       ===================================================== */

    @@media (max-width: 767px) {
        .producto-imagen-contenedor {
            height: 210px;
        }
    }
</style>

<div class="container pb-5">

    <!-- TITULO DEL CATALOGO -->

    <h1 class="mb-4 fw-bold">
        Catálogo de productos
    </h1>

    <!-- BUSCADOR Y FILTROS -->

    <form asp-controller="Productos"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <!-- BUSCADOR -->

        <div class="col-md-4">

            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar productos..." />

        </div>

        <!-- FILTRO DE CATEGORIA -->

        <div class="col-md-3">

            <select name="categoriaId"
                    asp-items="ViewBag.Categorias"
                    class="form-select">

                <option value="">
                    Todas las categorías
                </option>

            </select>

        </div>

        <!-- FILTRO DE MARCA -->

        <div class="col-md-3">

            <select name="marcaId"
                    asp-items="ViewBag.Marcas"
                    class="form-select">

                <option value="">
                    Todas las marcas
                </option>

            </select>

        </div>

        <!-- BOTON BUSCAR -->

        <div class="col-md-2 d-grid">

            <button type="submit"
                    class="btn btn-success">
                Buscar
            </button>

        </div>

        <!-- LIMPIAR FILTROS -->

        <div class="col-12">

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-outline-light btn-sm">
                Limpiar filtros
            </a>

        </div>

    </form>

    <!-- CANTIDAD DE RESULTADOS -->

    <p class="text-secondary mb-4">
        Productos encontrados: @Model.Count()
    </p>

    <!-- LISTADO DE PRODUCTOS -->

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            No se encontraron productos.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var producto in Model)
            {
                // Buscar el numero de fotografia correspondiente
                // al nombre del producto, independientemente
                // del ID que tenga en SQL Server.

                var tieneImagen = imagenesProductos.TryGetValue(
                    producto.Nombre,
                    out int numeroImagen
                );

                var rutaImagen = tieneImagen
                    ? Url.Content(
                        $"~/images/productos/producto-{numeroImagen}.jfif")
                    : "";

                <div class="col-md-6 col-lg-4">

                    <div class="card bg-dark text-light h-100 border-secondary producto-card">

                        <!-- FOTOGRAFIA DEL PRODUCTO -->

                        <a asp-controller="Productos"
                           asp-action="Detalle"
                           asp-route-id="@producto.Id"
                           class="text-decoration-none">

                            <div class="producto-imagen-contenedor">

                                @if (tieneImagen)
                                {
                                    <img src="@rutaImagen"
                                         class="producto-imagen"
                                         alt="@producto.Nombre"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="text-center text-secondary">
                                        <p class="mb-0">
                                            Imagen no disponible
                                        </p>
                                    </div>
                                }

                            </div>

                        </a>

                        <!-- INFORMACION DEL PRODUCTO -->

                        <div class="card-body d-flex flex-column">

                            <!-- NOMBRE -->

                            <h5 class="card-title producto-nombre">
                                @producto.Nombre
                            </h5>

                            <!-- CATEGORIA Y MARCA -->

                            <p class="text-secondary small mb-2">

                                @producto.Categoria?.Nombre

                                |

                                @producto.Marca?.Nombre

                            </p>

                            <!-- DESCRIPCION -->

                            <p class="card-text text-secondary producto-descripcion">
                                @producto.Descripcion
                            </p>

                            <!-- PRECIO -->

                            <p class="text-success producto-precio mt-auto mb-2">

                                $ @producto.Precio.ToString("N2")

                            </p>

                            <!-- STOCK -->

                            @if (producto.Stock > 0)
                            {
                                <p class="text-light producto-stock mb-0">

                                    <span class="text-success">●</span>

                                    Stock disponible: @producto.Stock

                                </p>
                            }
                            else
                            {
                                <p class="text-danger producto-stock mb-0">

                                    ● Sin stock

                                </p>
                            }

                            <!-- VER DETALLE -->

                            <a asp-controller="Productos"
                               asp-action="Detalle"
                               asp-route-id="@producto.Id"
                               class="btn btn-outline-success mt-3">

                                Ver detalle

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>