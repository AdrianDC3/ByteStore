@model ByteStore.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;

    // =====================================================
    // CORRESPONDENCIA DE PRODUCTOS E IMAGENES
    // =====================================================
    // Los IDs de SQL Server remoto son diferentes
    // de los IDs originales de LocalDB.
    //
    // Relacionamos cada imagen con el nombre del producto
    // para que funcione correctamente en ambos entornos.

    var imagenesProductos = new Dictionary<string, int>(
        StringComparer.OrdinalIgnoreCase)
    {
        // PROCESADORES
        { "Procesador AMD Ryzen 7 5700X", 1 },
        { "AMD Ryzen 5 5600", 2 },
        { "Intel Core i5 12400F", 3 },
        { "Intel Core i7 12700K", 4 },

        // MOTHERBOARDS
        { "ASUS Prime B550M-A", 5 },
        { "MSI B550 Gaming Plus", 6 },
        { "Gigabyte B760M DS3H", 7 },
        { "ASUS TUF Gaming B650", 8 },

        // TARJETAS GRAFICAS
        { "MSI GeForce RTX 4060", 9 },
        { "ASUS GeForce RTX 4070", 10 },
        { "Gigabyte Radeon RX 7600", 11 },
        { "MSI Radeon RX 6600", 12 },

        // MEMORIAS RAM
        { "Kingston Fury Beast 16GB DDR4", 13 },
        { "Corsair Vengeance 16GB DDR4", 14 },
        { "Kingston Fury Beast 32GB DDR5", 15 },
        { "Corsair Vengeance 32GB DDR5", 16 },

        // ALMACENAMIENTO
        { "Kingston NV2 500GB", 17 },
        { "Kingston NV2 1TB", 18 },
        { "Samsung 990 PRO 1TB", 19 },
        { "WD Blue SN580 1TB", 20 },

        // FUENTES DE ALIMENTACION
        { "Corsair CX550", 21 },
        { "Cooler Master MWE 650", 22 },
        { "Seasonic Focus GX 750", 23 },
        { "Corsair RM850e", 24 },

        // REFRIGERACION
        { "DeepCool AK400", 25 },
        { "Cooler Master Hyper 212", 26 },
        { "DeepCool AK620", 27 },
        { "NZXT Kraken 240", 28 },

        // GABINETES
        { "Corsair 4000D Airflow", 29 },
        { "NZXT H5 Flow", 30 },
        { "Cooler Master TD500 Mesh", 31 },
        { "DeepCool CH370", 32 },

        // MOUSE
        { "Logitech G203", 33 },
        { "Logitech G305", 34 },
        { "Razer DeathAdder V2", 35 },
        { "Redragon Cobra M711", 36 },

        // TECLADOS
        { "Redragon Kumara K552", 37 },
        { "Logitech G213", 38 },
        { "Razer BlackWidow V3", 39 },
        { "Corsair K70 RGB", 40 },

        // MONITORES
        { "LG UltraGear 24GN60R", 41 },
        { "Samsung Odyssey G4 25", 42 },
        { "ASUS TUF VG27AQ", 43 },
        { "Acer Nitro VG240Y", 44 }
    };

    var tieneImagen = imagenesProductos.TryGetValue(
        Model.Nombre,
        out int numeroImagen
    );

    var rutaImagen = tieneImagen
        ? Url.Content(
            $"~/images/productos/producto-{numeroImagen}.jfif")
        : "";
}

<style>
    /* =====================================================
       TARJETA PRINCIPAL
       ===================================================== */

    .detalle-card {
        border-radius: 16px;
        overflow: hidden;
    }

    /* =====================================================
       CONTENEDOR DE LA FOTOGRAFIA
       ===================================================== */

    .detalle-imagen-contenedor {
        background-color: #ffffff;
        border-radius: 12px;

        min-height: 400px;
        padding: 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: hidden;
    }

    .detalle-imagen {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        transition: transform 0.25s ease;
    }

    .detalle-imagen:hover {
        transform: scale(1.04);
    }

    /* =====================================================
       INFORMACION DEL PRODUCTO
       ===================================================== */

    .detalle-nombre {
        font-weight: 800;
        line-height: 1.2;
    }

    .detalle-etiqueta {
        font-size: 0.9rem;
        color: #adb5bd;
    }

    .detalle-descripcion {
        line-height: 1.7;
        color: #dee2e6;
    }

    .detalle-precio {
        font-size: 2rem;
        font-weight: 800;
    }

    .detalle-stock {
        font-size: 0.95rem;
    }

    /* =====================================================
       DISEÑO RESPONSIVE
       ===================================================== */

    @@media (max-width: 767px) {
        .detalle-imagen-contenedor {
            min-height: 280px;
            padding: 20px;
        }

        .detalle-imagen {
            max-height: 300px;
        }

        .detalle-precio {
            font-size: 1.7rem;
        }
    }
</style>

<div class="container py-4">

    <!-- VOLVER AL CATALOGO -->

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-light mb-4">

        Volver al catálogo

    </a>

    <!-- TARJETA DEL PRODUCTO -->

    <div class="card bg-dark text-light border-secondary detalle-card">

        <div class="card-body p-4">

            <div class="row g-4 align-items-start">

                <!-- COLUMNA IZQUIERDA: IMAGEN -->

                <div class="col-lg-6">

                    <div class="detalle-imagen-contenedor">

                        @if (tieneImagen)
                        {
                            <img src="@rutaImagen"
                                 class="detalle-imagen"
                                 alt="@Model.Nombre" />
                        }
                        else
                        {
                            <div class="text-center text-secondary">

                                <p class="mb-0">
                                    Imagen no disponible
                                </p>

                            </div>
                        }

                    </div>

                </div>

                <!-- COLUMNA DERECHA: INFORMACION -->

                <div class="col-lg-6">

                    <!-- NOMBRE -->

                    <h1 class="detalle-nombre mb-3">
                        @Model.Nombre
                    </h1>

                    <!-- CATEGORIA -->

                    <p class="detalle-etiqueta mb-2">

                        <strong>Categoría:</strong>

                        @Model.Categoria?.Nombre

                    </p>

                    <!-- MARCA -->

                    <p class="detalle-etiqueta mb-3">

                        <strong>Marca:</strong>

                        @Model.Marca?.Nombre

                    </p>

                    <hr class="border-secondary" />

                    <!-- DESCRIPCION -->

                    <h5 class="fw-semibold mb-2">
                        Descripción
                    </h5>

                    <p class="detalle-descripcion">
                        @Model.Descripcion
                    </p>

                    <!-- PRECIO -->

                    <h2 class="text-success detalle-precio my-4">

                        $ @Model.Precio.ToString("N2")

                    </h2>

                    <!-- STOCK -->

                    @if (Model.Stock > 0)
                    {
                        <p class="text-success detalle-stock">

                            ● Disponible - @Model.Stock unidades

                        </p>
                    }
                    else
                    {
                        <p class="text-danger detalle-stock">

                            ● Producto sin stock

                        </p>
                    }

                    <!-- MENSAJES DE ERROR -->

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mt-3">

                            @TempData["Error"]

                        </div>
                    }

                    <!-- AGREGAR AL CARRITO -->

                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Carrito"
                              asp-action="Agregar"
                              method="post"
                              class="mt-4">

                            @Html.AntiForgeryToken()

                            <!-- ID REAL DEL PRODUCTO -->

                            <input type="hidden"
                                   name="productoId"
                                   value="@Model.Id" />

                            <!-- CANTIDAD -->

                            <div class="mb-3">

                                <label for="cantidad"
                                       class="form-label">

                                    Cantidad

                                </label>

                                <input type="number"
                                       id="cantidad"
                                       name="cantidad"
                                       value="1"
                                       min="1"
                                       max="@Model.Stock"
                                       class="form-control"
                                       style="max-width: 120px;"
                                       required />

                            </div>

                            <!-- BOTON -->

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                🛒 Agregar al carrito

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>