@model ByteStore.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container py-4">

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-light mb-4">
        Volver al catálogo
    </a>

    <div class="card bg-dark text-light border-secondary">
        <div class="card-body p-4">

            <h1 class="fw-bold mb-3">@Model.Nombre</h1>

            <p class="text-secondary">
                Categoría: @Model.Categoria?.Nombre
            </p>

            <p class="text-secondary">
                Marca: @Model.Marca?.Nombre
            </p>

            <hr class="border-secondary" />

            <h5>Descripción</h5>
            <p>@Model.Descripcion</p>

            <h2 class="text-success fw-bold my-4">
                $ @Model.Precio.ToString("N2")
            </h2>

            @if (Model.Stock > 0)
            {
                <p class="text-success">
                    Disponible - @Model.Stock unidades
                </p>
            }
            else
            {
                <p class="text-danger">
                    Producto sin stock
                </p>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mt-3">
                    @TempData["Error"]
                </div>
            }

            @if (Model.Stock > 0)
            {
                <form asp-controller="Carrito"
                      asp-action="Agregar"
                      method="post"
                      class="mt-4">

                    <input type="hidden"
                           name="productoId"
                           value="@Model.Id" />

                    <div class="mb-3">
                        <label for="cantidad" class="form-label">
                            Cantidad
                        </label>

                        <input type="number"
                               id="cantidad"
                               name="cantidad"
                               value="1"
                               min="1"
                               max="@Model.Stock"
                               class="form-control"
                               style="max-width: 120px;"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-success btn-lg">
                        🛒 Agregar al carrito
                    </button>
                </form>
            }
        </div>
    </div>
</div>

