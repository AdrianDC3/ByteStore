@model ByteStore.Models.Producto
@using ByteStore.Helpers

@{
    ViewData["Title"] = Model.Nombre;

    var rutaImagen = ImagenProductoHelper.ObtenerRuta(Model.Nombre);
}

<div class="container py-4">

    <!-- VOLVER AL CATALOGO -->

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-light mb-4">
        Volver al catálogo
    </a>

    <!-- DETALLE DEL PRODUCTO -->

    <div class="card bg-dark text-light border-secondary detalle-card">

        <div class="card-body p-4">

            <div class="row g-4 align-items-start">

                <!-- IMAGEN -->

                <div class="col-lg-6">

                    <div class="detalle-imagen-contenedor">

                        @if (rutaImagen != null)
                        {
                            <img src="@Url.Content(rutaImagen)"
                                 class="detalle-imagen"
                                 alt="@Model.Nombre" />
                        }
                        else
                        {
                            <div class="text-center text-secondary">

                                <p class="mb-0">
                                    Imagen no disponible
                                </p>

                            </div>
                        }

                    </div>

                </div>

                <!-- INFORMACION -->

                <div class="col-lg-6">

                    <h1 class="detalle-nombre mb-3">
                        @Model.Nombre
                    </h1>

                    <p class="detalle-etiqueta mb-2">
                        <strong>Categoría:</strong>
                        @Model.Categoria?.Nombre
                    </p>

                    <p class="detalle-etiqueta mb-3">
                        <strong>Marca:</strong>
                        @Model.Marca?.Nombre
                    </p>

                    <hr class="border-secondary" />

                    <h5 class="fw-semibold mb-2">
                        Descripción
                    </h5>

                    <p class="detalle-descripcion">
                        @Model.Descripcion
                    </p>

                    <!-- PRECIO -->

                    <h2 class="text-success detalle-precio my-4">
                        $ @Model.Precio.ToString("N2")
                    </h2>

                    <!-- STOCK -->
                    @if (Model.Stock > 0)
                    {
                        <p class="text-success detalle-stock">
                            ● Disponible - @Model.Stock unidades
                        </p>
                    }
                    else
                    {
                        <p class="text-danger detalle-stock">
                            ● Producto sin stock
                        </p>
                    }

                    <!-- MENSAJE DE ERROR -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @TempData["Error"]
                        </div>
                    }

                    <!-- AGREGAR AL CARRITO -->
                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Carrito"
                              asp-action="Agregar"
                              method="post"
                              class="mt-4">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productoId"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <label for="cantidad"
                                       class="form-label">
                                    Cantidad
                                </label>

                                <input type="number"
                                       id="cantidad"
                                       name="cantidad"
                                       value="1"
                                       min="1"
                                       max="@Model.Stock"
                                       class="form-control detalle-cantidad"
                                       required />

                            </div>

                            <button type="submit"
                                    class="btn btn-success btn-lg">
                                🛒 Agregar al carrito
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/producto-detalle.css"
          asp-append-version="true" />

}