@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">

    @if (SignInManager.IsSignedIn(User))
    {
        bool esAdministrador = User.IsInRole("Administrador");

        <li class="nav-item dropdown">

            <button class="nav-link dropdown-toggle text-light d-flex align-items-center gap-2"
                    type="button"
                    id="menuMiCuenta"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <span aria-hidden="true">👤</span>
                Mi cuenta

            </button>

            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark"
                aria-labelledby="menuMiCuenta">

                @if (esAdministrador)
                {
                    <li>
                        <h6 class="dropdown-header text-success">
                            ADMINISTRACIÓN
                        </h6>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="AdminProductos"
                           asp-action="Index">
                            📦 Productos y stock
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="AdminPedidos"
                           asp-action="Index">
                            📋 Pedidos y ventas
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider" />
                    </li>
                }
                else
                {
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="Pedidos"
                           asp-action="MisPedidos">
                            📦 Mis pedidos
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider" />
                    </li>
                }

                <!-- NUEVA PAGINA DE PERFIL -->
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="MiCuenta"
                       asp-action="Index">
                        ⚙️ Administrar cuenta
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post">

                        <button type="submit"
                                class="dropdown-item text-danger">
                            🚪 Cerrar sesión
                        </button>

                    </form>
                </li>

            </ul>

        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light"
               asp-area="Identity"
               asp-page="/Account/Register">
                Registrarse
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-light"
               asp-area="Identity"
               asp-page="/Account/Login">
                Iniciar sesión
            </a>
        </li>
    }

</ul>