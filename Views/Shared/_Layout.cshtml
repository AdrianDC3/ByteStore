<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ByteStore</title>

    <script type="importmap"></script>

    <!-- BOOTSTRAP -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ESTILOS GENERALES -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ByteStore.styles.css"
          asp-append-version="true" />

    <!-- ESTILOS ESPECIFICOS DE CADA PAGINA -->

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- NAVEGACION -->

    <partial name="_Navbar" />

    <!-- CONTENIDO PRINCIPAL -->

    <div class="container layout-contenido">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- CARRITO LATERAL -->

    <partial name="_CarritoLateral" />

    <!-- AUTENTICACION -->

    <partial name="_ModalLogin" />

    <partial name="_ModalRegistro" />

    <!-- PIE DE PAGINA -->

    <partial name="_Footer" />

    <!-- BIBLIOTECAS JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JAVASCRIPT GENERAL -->

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- CARRITO -->

    <script src="~/js/carrito.js"
            asp-append-version="true"></script>

    <!-- LOGIN Y REGISTRO -->

    <script src="~/js/autenticacion.js"
            asp-append-version="true"></script>

    <!-- SCRIPTS ESPECIFICOS DE CADA PAGINA -->

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>