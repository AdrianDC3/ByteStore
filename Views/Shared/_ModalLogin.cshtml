<div class="modal fade"
     id="modalLogin"
     tabindex="-1"
     aria-labelledby="tituloModalLogin"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-dark text-light border-secondary">

            <!-- ENCABEZADO -->

            <div class="modal-header border-secondary">

                <div>

                    <h5 class="modal-title text-success fw-bold"
                        id="tituloModalLogin">
                        ⚡ ByteStore
                    </h5>

                    <h6 class="text-light mt-2 mb-0">
                        Iniciar sesión
                    </h6>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <!-- FORMULARIO -->

            <div class="modal-body p-4">

                <form id="formLoginModal"
                      asp-area=""
                      asp-controller="LoginModal"
                      asp-action="IniciarSesion"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div id="errorLoginModal"
                         class="alert alert-danger d-none"
                         role="alert"
                         aria-live="polite">
                    </div>

                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label for="loginEmail" class="form-label">
                            Correo electrónico
                        </label>

                        <input type="email"
                               id="loginEmail"
                               name="Input.Email"
                               class="form-control"
                               placeholder="correo@ejemplo.com"
                               autocomplete="username"
                               required />

                    </div>

                    <!-- CONTRASEÑA -->

                    <div class="mb-3">

                        <label for="loginPassword" class="form-label">
                            Contraseña
                        </label>

                        <input type="password"
                               id="loginPassword"
                               name="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               required />

                    </div>

                    <!-- RECORDARME -->

                    <div class="d-flex justify-content-between align-items-center gap-2 mb-4">

                        <div class="form-check">

                            <input type="checkbox"
                                   id="loginRecordarme"
                                   name="Input.RememberMe"
                                   value="true"
                                   class="form-check-input" />

                            <label for="loginRecordarme"
                                   class="form-check-label">
                                Recordarme
                            </label>

                        </div>

                        <a asp-area="Identity"
                           asp-page="/Account/ForgotPassword"
                           class="text-success text-decoration-none small">
                            ¿Olvidaste tu contraseña?
                        </a>

                    </div>

                    <button type="submit"
                            id="botonLoginModal"
                            class="btn btn-success w-100 fw-semibold">
                        Iniciar sesión
                    </button>

                </form>

            </div>

            <!-- PIE DEL MODAL -->

            <div class="modal-footer border-secondary justify-content-center">

                <span class="text-secondary">
                    ¿No tenés cuenta?
                </span>

                <button type="button"
                        class="btn btn-link text-success text-decoration-none fw-semibold p-0"
                        data-bs-toggle="modal"
                        data-bs-target="#modalRegistro">
                    Registrate
                </button>

            </div>

        </div>

    </div>

</div>
