@model List<ByteStore.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos y ventas";
}

<link rel="stylesheet"
      href="~/css/admin-pedidos.css"
      asp-append-version="true" />

<div class="container mt-4 mb-5">

    <!-- TITULO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-success mb-0">
            📋 Pedidos y ventas
        </h2>

    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- RESUMEN GENERAL -->

    <partial name="_ResumenVentas" model="Model" />

    <!-- LISTADO DE PEDIDOS -->
    @if (!Model.Any())
    {
        <div class="card bg-dark border-secondary text-center">

            <div class="card-body py-5">

                <h4 class="text-light">
                    Todavía no hay pedidos registrados
                </h4>

                <p class="text-secondary mb-0">
                    Las compras realizadas por los clientes aparecerán acá.
                </p>

            </div>

        </div>
    }
    else
    {
        <partial name="_TablaVentas" model="Model" />
    }

    <!-- VOLVER -->

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">

        Volver al catálogo

    </a>

</div>