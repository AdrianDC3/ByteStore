@model List<ByteStore.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos y ventas";

    var usuarios = ViewBag.Usuarios as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success mb-0">
            📋 Pedidos y ventas
        </h2>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card bg-dark text-light border-secondary mb-4">
        <div class="card-body">
            <div class="row text-center g-3">

                <div class="col-md-4">
                    <p class="text-secondary mb-1">
                        Total de pedidos
                    </p>
                    <h3 class="text-light mb-0">
                        @Model.Count
                    </h3>
                </div>

                <div class="col-md-4">
                    <p class="text-secondary mb-1">
                        Pedidos pendientes
                    </p>
                    <h3 class="text-warning mb-0">
                        @Model.Count(p => p.Estado == "Pendiente")
                    </h3>
                </div>

                <div class="col-md-4">
                    <p class="text-secondary mb-1">
                        Importe total registrado
                    </p>
                    <h3 class="text-success mb-0">
                        $ @Model.Sum(p => p.Total).ToString("N2")
                    </h3>
                </div>

            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark border-secondary text-center">
            <div class="card-body py-5">

                <h4 class="text-light">
                    Todavía no hay pedidos registrados
                </h4>

                <p class="text-secondary mb-0">
                    Las compras realizadas por los clientes aparecerán acá.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-dark table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pedido in Model)
                    {
                        var correo = usuarios.TryGetValue(
                            pedido.UsuarioId, out var email)
                            ? email
                            : "Usuario no encontrado";

                        <tr>
                            <td class="fw-semibold">
                                #@pedido.Id
                            </td>

                            <td>
                                @pedido.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @correo
                            </td>

                            <td class="text-success fw-semibold">
                                $ @pedido.Total.ToString("N2")
                            </td>

                            <td>
                                @if (pedido.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (pedido.Estado == "En preparación")
                                {
                                    <span class="badge bg-info text-dark">
                                        En preparación
                                    </span>
                                }
                                else if (pedido.Estado == "Enviado")
                                {
                                    <span class="badge bg-primary">
                                        Enviado
                                    </span>
                                }
                                else if (pedido.Estado == "Entregado")
                                {
                                    <span class="badge bg-success">
                                        Entregado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @pedido.Estado
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2 flex-wrap">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-light"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#detalle-@pedido.Id"
                                            aria-expanded="false"
                                            aria-controls="detalle-@pedido.Id">
                                        Ver detalle
                                    </button>

                                    <form asp-controller="AdminPedidos"
                                          asp-action="CambiarEstado"
                                          method="post"
                                          class="d-flex align-items-center gap-2 m-0">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@pedido.Id" />

                                        <select name="nuevoEstado"
                                                class="form-select form-select-sm"
                                                style="min-width: 145px;"
                                                aria-label="Nuevo estado del pedido #@pedido.Id">

                                            <option value="Pendiente"
                                                    selected="@(pedido.Estado == "Pendiente")">
                                                Pendiente
                                            </option>

                                            <option value="En preparación"
                                                    selected="@(pedido.Estado == "En preparación")">
                                                En preparación
                                            </option>

                                            <option value="Enviado"
                                                    selected="@(pedido.Estado == "Enviado")">
                                                Enviado
                                            </option>

                                            <option value="Entregado"
                                                    selected="@(pedido.Estado == "Entregado")">
                                                Entregado
                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                title="Guardar estado">
                                            Guardar
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        <tr class="border-0">
                            <td colspan="6" class="p-0 border-0">

                                <div class="collapse" id="detalle-@pedido.Id">

                                    <div class="card bg-dark text-light border-secondary m-3">
                                        <div class="card-body">

                                            <h5 class="text-success mb-3">
                                                Productos del pedido #@pedido.Id
                                            </h5>

                                            <div class="table-responsive">

                                                <table class="table table-sm table-dark align-middle mb-0">

                                                    <thead>
                                                        <tr>
                                                            <th>Producto</th>
                                                            <th>Cantidad</th>
                                                            <th>Precio unitario</th>
                                                            <th>Subtotal</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>

                                                        @foreach (var detalle in pedido.Detalles)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @(detalle.Producto?.Nombre ?? "Producto no disponible")
                                                                </td>

                                                                <td>
                                                                    @detalle.Cantidad
                                                                </td>

                                                                <td>
                                                                    $ @detalle.PrecioUnitario.ToString("N2")
                                                                </td>

                                                                <td>
                                                                    $ @((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>

                                        </div>
                                    </div>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Volver al catálogo
    </a>

</div>

