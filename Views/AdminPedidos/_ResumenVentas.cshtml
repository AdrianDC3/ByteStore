@model List<ByteStore.Models.Pedido>

<div class="card bg-dark text-light border-secondary mb-4">

    <div class="card-body">

        <div class="row text-center g-3">

            <!-- TOTAL DE PEDIDOS -->

            <div class="col-md-4">

                <p class="text-secondary mb-1">
                    Total de pedidos
                </p>

                <h3 class="text-light mb-0">
                    @Model.Count
                </h3>

            </div>

            <!-- PEDIDOS PENDIENTES -->

            <div class="col-md-4">

                <p class="text-secondary mb-1">
                    Pedidos pendientes
                </p>

                <h3 class="text-warning mb-0">
                    @Model.Count(p => p.Estado == "Pendiente")
                </h3>

            </div>

            <!-- IMPORTE TOTAL -->

            <div class="col-md-4">

                <p class="text-secondary mb-1">
                    Importe total registrado
                </p>

                <h3 class="text-success mb-0">
                    $ @Model.Sum(p => p.Total).ToString("N2")
                </h3>

            </div>

        </div>

    </div>

</div>